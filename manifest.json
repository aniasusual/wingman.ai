{
  "manifest_version": 3,
  "name": "Wingman",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "storage",
    "tabCapture",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "transcript_window.html",
        "transcript_window.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}