{
  "manifest_version": 3,
  "name": "Wingman",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "storage",
    "tabCapture",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "xoegan.png"
  },
  "icons": {
    "16": "xoegan.png",
    "48": "xoegan.png",
    "128": "xoegan.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "transcript_window.html",
        "transcript_window.js",
        "xoegan.png",
        "pdf.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}