{
  "manifest_version": 3,
  "name": "Wingman",
  "version": "1.0",
  "description": "Transcribe and assist during live video calls.",
  "permissions": ["tabs", "storage", "scripting", "tabCapture", "activeTab"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
