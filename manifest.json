{
  "manifest_version": 3,
  "name": "Wingman",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "storage",
    "tabCapture",
    "desktopCapture",
    "scripting",
    "tabs",
    "identity",
    "system.display",
    "windows"
  ],
  "host_permissions": [
    "https://*.firebaseapp.com/*",
    "https://*.googleapis.com/*",
    "https://*.gstatic.com/*"
  ],
  "oauth2": {
    "client_id": "22885003383-p7m9ihpo6oe269cm33k7jg30gd8gd40v.apps.googleusercontent.com",
    "scopes": ["email", "profile"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "./icons/xoegan.png"
  },
  "icons": {
    "16": "./icons/xoegan.png",
    "48": "./icons/xoegan.png",
    "128": "./icons/xoegan.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "transcript_window.html",
        "transcript_window.js",
        "./icons/xoegan.png",
        "./lib/pdf.min.js",
        "lib/tf.min.js",
        "models/shouldQuery/model.json",
        "models/shouldQuery/*.bin",
        "sandbox.html",
        "./lib/tessdata/*",
        "./lib/tesseract.min.js",
        "./lib/worker.min.js",
        "./lib/tesseract-core.wasm.js",
        "./lib/tessdata/*.traineddata.gz",
        "sandbox/ocr.html",
        "sandbox/ocr.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'"
  },
  "sandbox": {
    "pages": ["sandbox.html", "ocr.html"]
  }
}
